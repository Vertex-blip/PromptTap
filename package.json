{
  "name": "prompttap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multilingual Telegram prompt library and Mini App",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "import": "node scripts/import-archive.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "setup:bot": "node scripts/setup-bot.mjs",
    "setup:webhook": "node --env-file-if-exists=.env scripts/setup-webhook.mjs",
    "sync:catalog": "node --env-file-if-exists=.env scripts/sync-catalog.mjs",
    "security": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "ai": "^7.0.179",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "grammy": "^1.48.0",
    "helmet": "^8.3.0",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
