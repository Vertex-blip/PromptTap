# Telegram token from BotFather. Local preview works without it.
TELEGRAM_BOT_TOKEN=
# Public HTTPS origin for the Mini App, once hosted.
MINI_APP_URL=
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# AI model adapter. Leave empty to use clearly labelled local templates.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Production requires signed Telegram requests. Local preview is development only.
DATA_DIR=./data
AI_DAILY_LIMIT=250
# Set only to the actual reverse proxy address/CIDR, e.g. loopback for local Nginx.
TRUST_PROXY=
