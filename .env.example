# Local Node configuration. Keep real values in the ignored .env file.
# Leave empty for a website-only preview; use a separate development bot.
# Do not run polling with the hosted bot while its webhook is active.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL for the Mini App.
MINI_APP_URL=https://vertex-blip.github.io/PromptTap/
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Leave AI_API_KEY empty to use clearly labelled local templates.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Production requires signed Telegram requests. Local preview is development only.
DATA_DIR=./data
AI_DAILY_LIMIT=250
# Remote catalog administration. The browser never receives these secrets.
SUPABASE_URL=https://jxfifiyzwcssledekqvk.supabase.co
# Optional project identifier for administrator tooling; not a service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Independent random values, at least 32 characters. Set privately when deploying.
APP_STORE_SECRET=
TELEGRAM_WEBHOOK_SECRET=
# Edge settings are provisioned privately in Postgres, not read from this file.
# Supabase supplies its own service-role credential to the Edge runtime.
# Set only to the actual reverse proxy address/CIDR, e.g. loopback for local Nginx.
TRUST_PROXY=
